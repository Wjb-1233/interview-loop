  "cards": [
    {
      "dot": "cyan",
      "title": "主链路",
      "items": [
        "学员 → SPA → nginx/Vite 反代 → FastAPI → 路由 → 服务 → MySQL",
        "结束面试时评分与计划勾销在同一个 finish 请求内完成",
        "所有接口都挂在 /api/v1 下，只有 /media/recordings 例外"
      ]
    },
    {
      "dot": "emerald",
      "title": "外部依赖",
      "items": [
        "LLM 网关按 .env 在 DeepSeek / 豆包 / 通义之间切换",
        "模型不可用时评分降级并落库，报告标注 degraded",
        "语音走豆包 duplex，同时最多 2 路会话"
      ]
    },
    {
      "dot": "orange",
      "title": "运行时",
      "items": [
        "微课视频由 lifespan 启动的 worker 轮询渲染",
        "渲染调用 video/ 的 Remotion 工程产出 mp4",
        "限流优先 Redis，连不上自动降级进程内计数"
      ]
    }
  ]
