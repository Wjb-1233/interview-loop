  "cards": [
    {
      "dot": "cyan",
      "title": "前端与接口",
      "items": [
        "Vue 3 + Vite；/api/v1 开发期由 Vite 代理到 8081，部署期同源反代",
        "访问令牌走 Bearer，刷新令牌用 HttpOnly Cookie（/auth/refresh）",
        "视频面试的 Simli 数字人由浏览器直接建 WebRTC，后端只发 5 分钟令牌"
      ]
    },
    {
      "dot": "emerald",
      "title": "后端进程",
      "items": [
        "单个 uvicorn 进程承载 17 组路由，REST 与 /voice/ws 同源同进程",
        "/voice/ws 做票据校验与 2 路会话槽位，再把帧转发给豆包",
        "媒体文件写本地目录，经 /media/tts、/media/lessons 静态挂载"
      ]
    },
    {
      "dot": "amber",
      "title": "外部智能服务",
      "items": [
        "DeepSeek chat/completions 承担评分、话术改写与计划生成",
        "豆包双工实时对话提供面试问答与语音，浏览器不直连",
        "TTS 依次尝试 seed-tts-2.0 → edge-tts → 系统语音",
        "SMTP 未配置时不报错，找回密码回退管理员工单"
      ]
    },
    {
      "dot": "rose",
      "title": "数据与部署",
      "items": [
        "MySQL 8.4 存业务数据；Redis 7.4 只做限流，不存业务状态",
        "两者都由 docker compose（career-coach）起在本机 3308 / 6380",
        "非生产启动时自动建表并写入演示账号与场景"
      ]
    }
  ]
