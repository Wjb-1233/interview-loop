  "cards": [
    {
      "dot": "cyan",
      "title": "先落库再调模型",
      "items": [
        "finish_session 先提交 FINISHED，再进入模型 I/O",
        "重试沿用同一会话 ID，不会产生第二份记录",
        "评分与计划勾销在同一次 finish 请求内完成"
      ]
    },
    {
      "dot": "emerald",
      "title": "模型与降级",
      "items": [
        "评分走 complete_json，模型不可用时降级并标记 degraded",
        "改写建议来自同一评分流程的第二遍模型调用",
        "已有评分默认直接返回，force=true 才重评"
      ]
    },
    {
      "dot": "orange",
      "title": "条件与后续",
      "items": [
        "仅当存在 plan_id + task_key 且非 TRANSFER 才勾销任务",
        "前端随后跳转 /report/{id}，报告页再 GET /evaluations/{id}",
        "报告页同时 GET /training-sessions/{id} 取消息"
      ]
    }
  ]
