# Backend
ENVIRONMENT=development

LOG_LEVEL=INFO
JWT_SECRET=replace-with-at-least-32-random-characters
JWT_ISSUER=career-coach-api
JWT_AUDIENCE=career-coach-web
CORS_ORIGINS=http://localhost:5173
AUTO_CREATE_SCHEMA=true
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20
DB_POOL_RECYCLE_SECONDS=1800
COOKIE_SAMESITE=lax
# COOKIE_DOMAIN=
LLM_PROVIDER=deepseek
LLM_API_KEY=
LLM_BASE_URL=https://api.deepseek.com
LLM_MODEL=deepseek-chat

# MySQL / Redis（先执行 docker compose up -d）
MYSQL_DATABASE=career_coach
MYSQL_USER=career
MYSQL_PASSWORD=career_dev_password
MYSQL_ROOT_PASSWORD=root_dev_password
MYSQL_PORT=3308
DATABASE_URL=mysql+asyncmy://career:career_dev_password@localhost:3308/career_coach?charset=utf8mb4
REDIS_ENABLED=true
REDIS_PORT=6380
REDIS_URL=redis://localhost:6380/0
REDIS_PASSWORD=
# TRUSTED_PROXY_COUNT=0  # 0=不信任任何代理头；N=取 X-Forwarded-For 右侧第 N 跳


# Frontend
VITE_API_BASE_URL=/api/v1


# 实时语音自动选择；可由管理员在部署配置中指定 auto / doubao / pipeline
VOICE_ENGINE=auto

# 在线数字人（Simli）：面试官嘴型视频。密钥只在后端换短时令牌，绝不下发浏览器；
# 留空即安全降级到本地 3D 面试官（/api/v1/avatar/simli-session 返回 503 SIMLI_NOT_CONFIGURED）。
# 密钥取自 https://app.simli.com ；脸 ID 默认用官方示例脸 Anna（Trinity-2 预设）。
SIMLI_API_KEY=
SIMLI_FACE_ID=14c60d62-6ebf-424d-b626-1f4f91c33b04

# 微课视频渲染引擎：python（默认，稳定）/ remotion（更花哨，Windows 上进程树可能挂住）
LESSON_VIDEO_ENGINE=python
# 渲染硬超时（秒）：超时的任务标记失败并放行队列，可点「重新生成」重试
LESSON_VIDEO_TIMEOUT_SECONDS=480
