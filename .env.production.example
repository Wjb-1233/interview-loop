# 生产环境变量模板：复制为 .env 后逐项替换（不要提交真实密钥）
# 用法见 docs/部署指南.md

# ── 基础 ─────────────────────────────────────────────
ENVIRONMENT=production

LOG_LEVEL=INFO
# 对外访问地址，必须 https，用于 CORS 与分享链接
PUBLIC_ORIGIN=https://your-domain.com
CORS_ORIGINS=https://your-domain.com

# ── 安全 ─────────────────────────────────────────────
# 至少 32 位随机串：python -c "import secrets;print(secrets.token_urlsafe(48))"
JWT_SECRET=replace-with-a-random-48-char-secret
# 录像回放链接的签名密钥，必须与 JWT_SECRET 分开配置
RECORDING_SIGNING_SECRET=replace-with-another-random-48-char-secret
COOKIE_SAMESITE=lax
ACCESS_TOKEN_MINUTES=30
REFRESH_TOKEN_DAYS=7
# 反向代理层数：nginx 一层写 1，限流键从 X-Forwarded-For 右侧数第 1 跳取（该跳由 nginx 追加，不可伪造）。
# 不设或写 0 = 不信任任何代理头，限流键直接取 TCP 对端地址：直连部署（前面没有代理）时必须为 0，
# 否则所有请求会共用一个限流键；写得比实际层数大则会把客户端伪造的条目当成限流键。
# 注意：docker-compose.prod.yml 已为 backend 显式设 TRUSTED_PROXY_COUNT=1（编排内一定有 nginx）。
TRUSTED_PROXY_COUNT=1

# ── 数据库（compose 会注入容器内地址，这里给 mysqldump 与本地排查用）──
MYSQL_DATABASE=career_coach
MYSQL_USER=career
MYSQL_PASSWORD=replace-with-strong-db-password
MYSQL_ROOT_PASSWORD=replace-with-strong-root-password
DATABASE_URL=mysql+asyncmy://career:replace@mysql:3306/career_coach?charset=utf8mb4
AUTO_CREATE_SCHEMA=false

# ── Redis ────────────────────────────────────────────
REDIS_ENABLED=true
REDIS_PASSWORD=replace-with-at-least-24-char-password

# ── 模型 ─────────────────────────────────────────────
LLM_PROVIDER=deepseek
LLM_API_KEY=replace-with-deepseek-key
LLM_BASE_URL=https://api.deepseek.com
LLM_MODEL=deepseek-chat
LLM_TIMEOUT_SECONDS=60
# 每个学员每天允许的模型调用次数（评分/追问/起草各算一次），按成本预算调整
MODEL_DAILY_QUOTA=400

# ── 语音（火山引擎，可选）────────────────────────────
DOUBAO_REALTIME_APP_ID=
DOUBAO_REALTIME_ACCESS_TOKEN=
DOUBAO_TTS_APP_ID=
DOUBAO_TTS_ACCESS_TOKEN=

# ── 邮件（忘记密码链接；不配置则回退为管理员工单）──────
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_STARTTLS=true
# 重置链接里的站点地址，必须是用户能访问的域名
APP_PUBLIC_URL=https://your-domain.com
PASSWORD_RESET_MINUTES=30
# 开启后：新注册账号需验证邮箱才能开始训练（未配置 SMTP 时自动跳过，避免锁死）
REQUIRE_EMAIL_VERIFICATION=false
EMAIL_VERIFICATION_HOURS=48

# ── 媒体 ─────────────────────────────────────────────
RECORDING_RETENTION_DAYS=30
# RECORDING_SIGNING_SECRET 只在上方「密钥」分节声明一次（此处重复空值会覆盖它，dotenv 后者生效）
RECORDING_JANITOR_ENABLED=true

# ── 向量库（可选，关闭时课程检索降级）────────────────

# ── 前端构建（一般不用改）────────────────────────────
VITE_API_BASE_URL=/api/v1

VOICE_ENGINE=auto
